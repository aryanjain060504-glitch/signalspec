# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
# Local development default or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/signalspec

# ── JWT Configuration ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=e7b4f8d92a1c6e3b5a7d9f2e4c8b0a1d3f5e7a9b1c3d5e7f9a1b3c5d7e9f1a3b
JWT_REFRESH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend & CORS ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Encryption Key (for storing sensitive third-party credentials) ──────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── AI Engine Configuration ─────────────────────────────────────────────
# Google Gemini API key (optional: fallback to high-fidelity mock AI engine if not provided)
GEMINI_API_KEY=

# ── Google OAuth (Optional) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Email Service (Optional - SMTP) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SignalSpec <noreply@signalspec.dev>

# ── Monitoring (Optional) ───────────────────────────────────────────────
SENTRY_DSN=
